# ── Database (Railway Postgres addon) ─────────────────────────────────────────
# Railway injects $DATABASE_URL automatically when you add a Postgres addon.
# Copy the "Postgres Connection URL" from the addon's Connect tab.
DATABASE_URL=postgresql://postgres:password@postgres.railway.internal:5432/railway

# ── Redis (Railway Redis addon) ───────────────────────────────────────────────
# Railway injects $REDIS_URL automatically when you add a Redis addon.
REDIS_URL=redis://default:password@redis.railway.internal:6379

# ── Stripe (test mode to start) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ── Observability (optional but recommended) ──────────────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── Frontend (Next.js — set in Railway frontend service env vars) ─────────────
# NEXT_PUBLIC_ prefix makes these available in the browser
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
